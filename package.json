{
  "name": "idlehub",
  "productName": "IdleHub",
  "version": "0.1.0",
  "description": "Painel para jogos idle de navegador com várias contas, watchdog e alertas",
  "main": "src/main/main.js",
  "author": "IdleHub",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "test:idlelive": "cd idlelive && node scripts/check.js && node --test",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.idlehub.app",
    "productName": "IdleHub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "idlelive/**/*",
      "!idlelive/test/**",
      "!idlelive/scripts/**",
      "!idlelive/.github/**",
      "!idlelive/iniciar.bat",
      "!idlelive/{AGENTS,CLAUDE,DESIGN}.md",
      "!node_modules/@awesome.me/webawesome/dist/**",
      "!node_modules/@fortawesome/fontawesome-free/{css,js,less,scss,sprites,webfonts,metadata}/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RicardooFilho",
        "repo": "IdleHub"
      }
    ],
    "asarUnpack": [
      "idlelive/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/montserrat": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.0",
    "electron-updater": "^6.8.11"
  }
}
